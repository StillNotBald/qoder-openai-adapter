# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# Your Qoder Personal Access Token (Qoder console -> Settings -> Integrations ->
# Create Personal Access Token). Starts with pt-. This is YOUR credential; the
# adapter never sends it anywhere except Qoder's own official SDK.
QODER_PERSONAL_ACCESS_TOKEN=

# Default model tier. On a Free Qoder plan only `qfmodel` (Qwen3.8-Flash) is
# enabled for free. Paid plans enable: auto, ultimate, fast, efficient, smodel,
# cmodel, qmodel_38max, kmodel, gmodel, gfmodel, dmodel, dfmodel, mmodel.
QODER_MODEL=qfmodel

# Optional: require callers to send `Authorization: Bearer <this>` to the shim.
# Leave empty to disable auth (fine for localhost-only use).
# SHIM_API_KEY=

# Optional: port (default 8787)
# PORT=8787
